# Copy this file to .env and fill in real values. Never commit the real .env.

# Absolute path to the target project's root folder (e.g. your Student Portal backend)
TARGET_PROJECT_ROOT=/absolute/path/to/student-portal-backend

# Connection string for a READ-ONLY Postgres user -- see README.md for why,
# and for the SQL to create one.
TARGET_DATABASE_URL=postgresql://readonly_user:password@localhost:5432/student_portal

# Base URL where the target app's server is running
TARGET_BASE_URL=http://localhost:4000

# Path to routes.json generated by scripts/dump_routes.js
TARGET_ROUTES_MANIFEST=/absolute/path/to/routes.json

# Optional: JWT for endpoints that require login
TARGET_AUTH_TOKEN=
